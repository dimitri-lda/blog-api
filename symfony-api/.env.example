APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
COMMERCE_DEFAULT_COUNTRY=DE
MYFIN_EUR_BYN_URL=https://myfin.by/converter/eur-byn
WALUTOMAT_EUR_PLN_URL=
WALUTOMAT_API_TOKEN=
GEOIP_URL=https://ipwho.is/{ip}
PAYMENT_ENCRYPTION_KEY=base64:change-me
LARAVEL_LEGACY_APP_KEY=base64:change-me-during-migration
SHOP_PAY_ENABLED=false
SHOP_PAY_SHOP_DOMAIN=
SHOP_PAY_API_VERSION=2026-07
SHOP_PAY_SHOP_ID=
SHOP_PAY_CLIENT_ID=
SHOP_PAY_STOREFRONT_PRIVATE_TOKEN=
SHOP_PAY_ADMIN_ACCESS_TOKEN=
SHOP_PAY_APP_CLIENT_SECRET=
SHOP_PAY_WEBHOOK_URL=https://blog-api.local/api/v1/webhooks/shopify/orders

DEFAULT_URI=http://localhost
FRONTEND_URL=http://localhost:8080

DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=18&charset=utf8"

REDIS_URL="redis://127.0.0.1:6379"
STOREFRONT_CACHE_ENABLED=true
LOCK_DSN="redis://127.0.0.1:6379"

MESSENGER_TRANSPORT_DSN="redis://127.0.0.1:6379/messages"
MESSENGER_FAILED_TRANSPORT_DSN="redis://127.0.0.1:6379/messages_failed"

MAILER_DSN="smtp://127.0.0.1:1025"
MAILER_FROM=no-reply@blog-api.local

SESSION_COOKIE_NAME=storefront_session
SESSION_COOKIE_SECURE=false
TRUSTED_PROXIES="127.0.0.1,REMOTE_ADDR"
TRUSTED_HOSTS="^(localhost|blog-api\\.local|admin\\.blog-api\\.local)$"
