{
    auto_https off
}

:80 {
    encode zstd gzip

    @backend path /api/* /healthz
    handle @backend {
        root * /srv/app/public
        php_fastcgi php:9000
        file_server
    }

    handle {
        root * /srv/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
